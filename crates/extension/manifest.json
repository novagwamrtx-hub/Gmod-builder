{
  "manifest_version": 3,
  "name": "GMod Collection Builder",
  "version": "0.1.1",
  "description": "Fills and tidies your Steam Workshop collections: add or remove addons in bulk, and collect addons in a basket while you browse.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/sharedfiles/managecollection/*",
        "https://steamcommunity.com/sharedfiles/filedetails/*",
        "https://steamcommunity.com/workshop/filedetails/*"
      ],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pkg/gmcb_extension.js", "pkg/gmcb_extension_bg.wasm"],
      "matches": ["https://steamcommunity.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gmod-collection-builder@gmcb.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
